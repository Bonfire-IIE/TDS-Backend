DATABASE_URL=postgresql+psycopg://bonfire:CHANGE_ME@127.0.0.1:30432/bonfire_tds
REDIS_URL=redis://127.0.0.1:30379/0
OPA_URL=http://127.0.0.1:30818
OPA_DECISION_PATH=bonfire/usage/decision
REKOR_URL=
REKOR_WORKER_INTERVAL=30
CONNECTOR_CA_DIR=.data/connector-ca
SIGNING_KEY_ROOT=.data/signing-keys
KEYCLOAK_BASE_URL=http://127.0.0.1:30880
KEYCLOAK_REALM=bonfire
KEYCLOAK_CLIENT_ID=bonfire-tds
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_ID=bonfire-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
CONNECTOR_PLATFORM_API_PUBLIC_URL=https://tds.example.com/api/v1
CONNECTOR_PORTAL_IMAGE=ghcr.io/bonfire-iie/bonfire-connector-portal:2.0.0
CONNECTOR_SEATUNNEL_IMAGE=ghcr.io/bonfire-iie/seatunnel:2.3.8-s3-runtime
# Empty disables execution dispatch. Provision a random secret of at least 32 characters through the deployment administrator.
BONFIRE_EXECUTION_AUTH_MODE=signature
# shared-secret is a temporary compatibility mode; signature is the production default.
BONFIRE_EXECUTION_DISPATCH_SECRET=
PLATFORM_REGISTRY_ENABLED=false
PLATFORM_REGISTRY=
PLATFORM_REGISTRY_PROJECT=
CORS_ORIGINS=["https://tds.example.com"]
TRANSPORT_MODE=http
